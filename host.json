{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      },
      "enableLiveMetricsFilters": true
    },
    "logLevel": {
      "default": "Information",
      "Microsoft.Azure.Functions.Worker": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "extensions": {
    "http": {
      "routePrefix": ""
    },
    "queues": {
      "batchSize": 1,
      "newBatchThreshold": 0,
      "maxDequeueCount": 1,
      "visibilityTimeout": "00:00:30"
    }
  },
  "functionTimeout": "00:30:00"
}
